{
  "name": "agenelf",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12 <25"
  },
  "scripts": {
    "node:check": "node node/scripts/check.ts",
    "node:test": "node --test --test-reporter=spec node/tests/*.test.ts",
    "node:start": "node node/apps/api/src/main.ts",
    "node:cli": "node node/apps/cli/src/main.ts",
    "node:runner": "node node/apps/runner/src/main.ts",
    "node:validation-runner": "node node/apps/validation-runner/src/main.ts",
    "test:node": "npm run node:check && npm run node:test"
  }
}
