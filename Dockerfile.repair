FROM node:24.18.0-bookworm-slim AS node-runtime

FROM python:3.12-slim

ENV NODE_ENV=production \
    npm_config_ignore_scripts=true \
    npm_config_audit=false \
    npm_config_fund=false \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY --from=node-runtime /usr/local/ /usr/local/

RUN apt-get update \
    && apt-get install -y --no-install-recommends git bash ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /agenelf
COPY package.json package-lock.json .node-version ./
COPY node ./node

CMD ["node", "node/apps/repair-runner/src/main.ts"]
