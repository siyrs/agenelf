# Agenelf 环境变量示例
# 使用方法：cp .env.example .env，然后填入真实密钥。
# 注意：.env 属于敏感文件，绝不挂载进容器可写区，也禁止 agent 修改。

# LLM API 密钥（必填，请替换为真实值）
OPENAI_API_KEY=sk-请替换为你的密钥

# LLM API 基础地址（默认 Moonshot AI）
OPENAI_BASE_URL=https://api.moonshot.cn/v1

# 默认使用的模型
AGENELF_MODEL=kimi-k2-0905-preview

# GitHub 个人访问令牌（用于 https 推送与创建 Release；可选，ssh 推送可不填）
# 获取方式：GitHub -> Settings -> Developer settings -> Personal access tokens
#GITHUB_TOKEN=ghp_请替换为你的令牌

# 晋升后自动备份开关：置 1 时，promote.sh 成功晋升后自动调用
# scripts/github_backup.sh 推送 app/ 与 scripts/ 的状态备份到 origin；
# 备份失败仅警告，不影响晋升结果。默认 0 关闭。
GITHUB_AUTO_BACKUP=0
