# Copy to .env. Never commit the real file.
OPENAI_API_KEY=sk-replace-me
OPENAI_BASE_URL=https://api.moonshot.cn/v1
AGENELF_MODEL=kimi-k2-0905-preview

# Strongly recommended even though Docker binds the API to 127.0.0.1 by default.
AGENELF_API_TOKEN=replace-with-a-long-random-token

# Optional GitHub automation.
# GITHUB_TOKEN=ghp_replace-me
GITHUB_AUTO_BACKUP=0

# Match the host operator account so bind-mounted request/decision files and
# SSH keys keep usable ownership. Check with: id -u; id -g
AGENELF_UID=1000
AGENELF_GID=1000
