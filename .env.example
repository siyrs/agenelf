# Copy to .env. Never commit the real file.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.moonshot.cn/v1
AGENELF_MODEL=kimi-k2-0905-preview

# !!! REQUIRED — fail-closed !!!
# AGENELF_API_TOKEN 未配置时，API 所有受保护端点一律拒绝服务（503），
# 而不是静默免鉴权。即使 Docker 默认只绑定 127.0.0.1，也必须配置。
# 不要照抄右侧占位符或任何示例值；请生成独立强随机 token，例如：
#   openssl rand -hex 32
#   python -c "import secrets; print(secrets.token_hex(32))"
# 仅限本地开发调试可设 AGENELF_API_ALLOW_INSECURE=1 临时绕过，生产严禁开启。
# AGENELF_API_ALLOW_INSECURE=0
AGENELF_API_TOKEN=

# Private owner configuration mounted into the Agent container.
AGENELF_LOCAL_DIR=/agenelf/local
AGENELF_VALIDATION_FILE=/agenelf/local/validation.yaml
AGENELF_REPOSITORIES_FILE=/agenelf/local/repositories.yaml
AGENELF_SELF_DIR=/agenelf/local/self
AGENELF_SCRATCH_DIR=/agenelf/workspace/scratch

# Executable Python extensions are disabled by default. Keep these at 0 in production.
AGENELF_ENABLE_APP_SPACE_SKILLS=0
AGENELF_ENABLE_SKILL_FORGE=0
AGENELF_ENABLE_DIRECT_SKILL_REGISTRATION=0

# Evolution promotion is manual by default.
AGENELF_AUTO_PROMOTE_EVOLUTION=0
AGENELF_WATCH_INTERVAL=10

# Exact operation requests expire and cannot authorize a stale future action.
# Identical unfinished requests inside the same live window reuse one op- ID.
AGENELF_OPERATION_READ_TTL_SECONDS=120
AGENELF_OPERATION_CHANGE_TTL_SECONDS=1800
AGENELF_OPERATION_PRIVILEGED_TTL_SECONDS=900

# Optional GitHub automation after a successful host-side promotion.
# GITHUB_TOKEN=ghp_replace-me
GITHUB_AUTO_BACKUP=0

# Match the host operator account so bind-mounted files keep usable ownership.
# Check with: id -u; id -g
AGENELF_UID=1000
AGENELF_GID=1000
